---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageNav from './PageNav.astro';
import { stripBase } from '../utils/paths';
import '../styles/content.css';

interface Props {
  title: string;
  description?: string;
  layout?: 'default' | 'wide';
}

const { title, description, layout = 'default' } = Astro.props;
const currentPath = stripBase(Astro.url.pathname);
---

<BaseLayout title={title} description={description}>
  <h1 class="page-title">{title}</h1>
  <div class:list={['page-body', { 'page-body--wide': layout === 'wide' }]}>
    <slot />
  </div>
  <PageNav currentPath={currentPath} />
</BaseLayout>
