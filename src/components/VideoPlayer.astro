---
import { withBase } from '../utils/paths';

interface Props {
  src: string;
  title?: string;
  description?: string;
}

const { src, title, description } = Astro.props;
---

{title && <h3 class="video-title">{title}</h3>}
<figure class="video-figure">
  <div class="video-container">
    <video class="video-player" controls preload="metadata">
      <source src={withBase(src)} type="video/mp4" />
      Your browser does not support the video tag. Please use a modern browser to watch this video.
    </video>
  </div>
  {description && <p class="video-description">{description}</p>}
</figure>

<style>
  .video-title {
    margin: 0 0 1rem;
    padding-top: 0.25rem;
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-header);
    line-height: 1.3;
  }

  :global(.video-grid .video-title:first-child) {
    margin-top: 0;
  }

  .video-figure {
    margin: 0 0 2rem;
  }

  .video-container {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
    background: var(--color-surface);
    border-radius: 0.375rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .video-player {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    max-width: 100%;
  }

  .video-description {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin-top: 0.75rem;
    margin-bottom: 0;
    line-height: 1.6;
  }
</style>
